# Токен бота «Батарейка» (@batareyka_svitlo_bot) от @BotFather (в Worker svitlomap он же BATAREYKA_BOT_TOKEN)
BOT_TOKEN=
# Тот же ключ, что BATAREYKA_API_KEY в Worker svitlomap
BATAREYKA_API_KEY=
# Адрес Mini App на Vercel (https://...)
MINIAPP_URL=
# Firestore. Локально удобнее путь к скачанному JSON-ключу, на Vercel — содержимое JSON целиком.
# Оба пусты → данные в памяти (только для разработки).
FIREBASE_SERVICE_ACCOUNT_FILE=
FIREBASE_SERVICE_ACCOUNT=
# Только для долгоживущего сервера (npm start): публичный адрес → вебхук. Пусто → long polling (локально). На Vercel не нужен.
WEBHOOK_URL=
# Секрет для вебхука Telegram (любая длинная строка)
WEBHOOK_SECRET=
SVITLOMAP_BASE=https://api.svitlomap.com.ua
PORT=3000
